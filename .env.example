NODE_ENV=development
HTTP_PORT=5000
HTTP_API_PREFIX=api
HTTP_TRUST_PROXY_HOPS=0
HTTP_HOST=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173
PUBLIC_WEBSITE_URL=http://localhost:3000
TRUSTED_BROWSER_ORIGINS=http://localhost:3000,http://localhost:5173
EMAIL_LOGO_URL=https://waveengineering.ge/logo-16k.svg
API_DOCS_ENABLED=true

DATABASE_URL=postgresql://user:password@localhost:5432/wave

# Generate JWT_SECRET with a secure secret manager or:
# openssl rand -base64 48
# Do not use this placeholder in production.
JWT_SECRET=replace-me-with-a-high-entropy-generated-value
JWT_AUDIENCE=wave-admin
JWT_ISSUER=wave-api
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

HETZNER_S3_ENDPOINT=https://example.objectstorage.com
HETZNER_S3_REGION=region
HETZNER_S3_BUCKET=bucket
HETZNER_S3_ACCESS_KEY=access-key
HETZNER_S3_SECRET_KEY=secret-key

MAIL_PROVIDER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-mailbox@example.com
MAIL_PASSWORD=use-an-app-password
MAIL_FROM=Wave Engineering <your-mailbox@example.com>
MAIL_TO=admin@example.com
CONTACT_NOTIFICATION_EMAIL=admin@example.com

# SMTP TLS modes:
# MAIL_PORT=465 requires MAIL_SECURE=true for implicit TLS.
# MAIL_PORT=587 requires MAIL_SECURE=false and uses STARTTLS.

AUTH_SIGNIN_BURST_LIMIT=5
AUTH_SIGNIN_BURST_WINDOW_SECONDS=60
AUTH_SIGNIN_SUSTAINED_LIMIT=20
AUTH_SIGNIN_SUSTAINED_WINDOW_SECONDS=900
